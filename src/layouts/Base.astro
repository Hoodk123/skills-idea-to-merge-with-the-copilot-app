---
const { title = "Mona's Bookmark Manager App" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light;
        --accent: #6558d3;
        --accent-strong: #5145b8;
        --border: #ded9e3;
        --muted: #77717d;
        --surface: #fff;
        --radius: 0.8rem;
        --font-body: 'Monaspace Neon', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        --font-head: 'Monaspace Xenon', 'Monaspace Neon', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      body {
        font-family: var(--font-body);
        color: #29262e;
        line-height: 1.5;
        max-width: 40rem;
        min-height: 100vh;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
        background:
          radial-gradient(ellipse at 92% 4%, #ece8ff 0, transparent 34rem),
          #f8f6f2;
      }
      header { margin-bottom: 1.5rem; }
      h1 { margin: 0 0 0.35rem; font-size: clamp(1.45rem, 5vw, 1.85rem); font-family: var(--font-head); letter-spacing: -0.035em; }
      .tagline { margin: 0; color: var(--muted); }

      .bookmark-panel {
        padding: 1.2rem;
        border: 1px solid #e8e3ec;
        border-radius: 1.1rem;
        background: color-mix(in srgb, var(--surface) 92%, transparent);
        box-shadow: 0 1.5rem 3.5rem #332a4610, 0 0.15rem 0.5rem #332a4608;
      }
      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        align-items: end;
        margin: 0 0 0.65rem;
      }
      .field { display: flex; flex-direction: column; gap: 0.4rem; flex: 1 1 16rem; }
      label { font-size: 0.8rem; font-weight: 700; }
      input {
        min-height: 2.8rem;
        padding: 0.65rem 0.8rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font: inherit;
        background: #fff;
        color: inherit;
        transition: border-color 160ms ease, box-shadow 160ms ease;
      }
      input:focus-visible,
      button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      button {
        min-height: 2.8rem;
        padding: 0.65rem 1rem;
        border: 1px solid transparent;
        border-radius: var(--radius);
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        transition: transform 140ms ease-out, background-color 140ms ease-out, border-color 140ms ease-out;
      }
      button:hover { background: var(--accent-strong); }
      button:active { transform: scale(0.98); }
      input:focus-visible { border-color: var(--accent); box-shadow: 0 0 0 3px #6558d31c; }
      .hint { margin: 0 0 1.4rem; font-size: 0.76rem; color: var(--muted); }
      .hint code { color: #5549b8; }
      .status { margin: 0 0 1rem; color: #5145b8; font-size: 0.8rem; }

      #list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0 0 0.65rem;
      }
      #list-header[hidden] { display: none; }
      .list-title { margin: 0; font-size: 0.95rem; font-family: var(--font-head); }
      .clear {
        background: transparent;
        color: var(--muted);
        border: 1px solid var(--border);
        min-height: 2.2rem;
        padding: 0.35rem 0.65rem;
        font-size: 0.72rem;
        font-weight: 600;
      }
      .clear:hover { background: #f5f2fa; border-color: #bcb3d0; color: #423a50; }

      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
      li.bookmark {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem 0.55rem;
        padding: 0.75rem 0.8rem;
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        background: var(--surface);
      }
      .bookmark .url { flex: 1 1 12rem; color: #453b8f; overflow-wrap: anywhere; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
      .bookmark .separator { color: #a39ca9; white-space: pre; }
      .bookmark .slug {
        font-family: var(--font-body);
        font-size: 0.72rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: #eeebff;
        color: #5145b8;
      }
      .bookmark .copy {
        background: transparent;
        color: #645e6a;
        border: 1px solid var(--border);
        min-height: 2rem;
        padding: 0.25rem 0.55rem;
        font-size: 0.7rem;
        font-weight: 600;
      }
      .bookmark .copy:hover { background: #f5f2fa; border-color: #bcb3d0; color: #423a50; }
      .empty {
        margin: 0;
        padding: 1.6rem 1rem;
        text-align: center;
        color: var(--muted);
        border: 1px dashed var(--border);
        border-radius: 0.8rem;
        background: #fbfafc;
      }
      .empty[hidden] { display: none; }

      footer { margin-top: 1.6rem; font-size: 0.72rem; color: var(--muted); text-align: center; }
      @media (prefers-reduced-motion: reduce) {
        input, button { transition: none; }
        button:active { transform: none; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
