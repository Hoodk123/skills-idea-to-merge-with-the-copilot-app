
<section class="bookmark-panel" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark <span aria-hidden="true">↗</span></button>
  </form>

  <p class="hint">Paste a URL with or without <code>https://</code>. Mona creates a private, local shortcut.</p>
  <p id="status" class="status" role="status" aria-live="polite" hidden></p>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import { formatBookmark, generateSlug, loadBookmarks, normalizeUrl, STORAGE_KEY } from '../lib/bookmarks.js';

  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('status');
  const clearButton = document.getElementById('clear-all');
  let bookmarks = [];

  function showStatus(message) {
    status.textContent = message;
    status.hidden = !message;
  }

  function save(nextBookmarks) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(nextBookmarks));
      bookmarks = nextBookmarks;
      return true;
    } catch {
      showStatus('Browser storage is unavailable. Your changes were not saved.');
      return false;
    }
  }

  function render() {
    list.replaceChildren();
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;

    for (const bookmark of bookmarks) {
      const row = document.createElement('li');
      row.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showStatus(`Copied ${bookmark.slug}.`);
        } catch {
          showStatus('Could not copy the slug. Select and copy it instead.');
        }
      });

      row.append(link, separator, slug, copyButton);
      list.append(row);
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();

    try {
      const url = normalizeUrl(input.value);
      const bookmark = { url, slug: generateSlug(bookmarks.map(({ slug }) => slug)) };
      if (save([...bookmarks, bookmark])) {
        input.value = '';
        showStatus(`Saved ${formatBookmark(bookmark)}.`);
        render();
      }
    } catch (error) {
      showStatus(error instanceof Error ? error.message : 'Could not save this URL.');
    }
  });

  clearButton.addEventListener('click', () => {
    if (bookmarks.length && window.confirm('Clear all saved bookmarks?') && save([])) {
      showStatus('All bookmarks cleared.');
      render();
    }
  });

  try {
    bookmarks = loadBookmarks(localStorage.getItem(STORAGE_KEY));
  } catch {
    showStatus('Browser storage is unavailable. Bookmarks cannot be loaded or saved.');
  }
  render();
</script>
